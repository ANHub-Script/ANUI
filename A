function autoNoobSmart()
	-- Jangan ubah level saat Noob baru saja mati (tunggu respawn)
	if NoobState.IsDead then return false, "Respawning..." end
	
	local damage = Boosts.NoobDamage(Player)
	local hpRatio = 0
	
	if NoobState.MaxHP > 0 then
	hpRatio = damage / NoobState.MaxHP
	end
	
	-- Jika damage >= 100% HP (bisa one-hit) → Next
	if hpRatio >= 1 then
	pcall(function()
		NoobInfoRemote:FireServer("Next")
	end)
	return true, "Next (One-hit!)"
	end
	
	-- Jika damage >= 50% HP → Next (efisien)
	if hpRatio >= 0.8 then
	pcall(function()
		NoobInfoRemote:FireServer("Next")
	end)
	return true, "Next (Efficient)"
	end
	
	-- Jika damage < 10% HP → Previous (terlalu kecil)
	if hpRatio < 0.4 then
	pcall(function()
		NoobInfoRemote:FireServer("Previous")
	end)
	return true, "Previous (Too weak)"
	end
	
	return false, string.format("Damage: %.1f%% HP", hpRatio * 100)
end


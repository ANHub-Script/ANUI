function HasEnabledResets()
	for _, resetType in ipairs(ResetOrder) do
	if Config.Upgraders["Auto" .. resetType] then
		return true
	end
	end

	return false
end

function ProcessNextReset()
	if #ResetOrder == 0 then
	return
	end

	local total = #ResetOrder
	for offset = 0, total - 1 do
	local index = ((ResetWorkerIndex + offset - 1) % total) + 1
	local resetType = ResetOrder[index]

	if Config.Upgraders["Auto" .. resetType] then
		ResetWorkerIndex = (index % total) + 1
		autoReset(resetType)
		return
	end
	end
end


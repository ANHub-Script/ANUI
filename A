function autoRuneForgeNormal()
	local currentLevel = Player.stats.RuneForge.Value
	if currentLevel >= 13 then return false, "MAXED" end

	local nextLevel = currentLevel + 1
	local level = tostring(nextLevel)
	-- Cek pembatasan Gym runes (level 8+ butuh BodyTier >= 4)
	if nextLevel >= 8 and Player.stats.BodyTier.Value < 4 then
	return false, "Need Body Tier 4"
	end

	local costData = RuneForgeDataNormal[level]
	if not costData then return false, "MAXED" end

	local runeObj = Player.Runes:FindFirstChild(costData.rune)
	if not runeObj then return false, "Rune not found" end

	local owned = runeObj.Value
	if owned >= costData.currency then
	pcall(function() RuneForgeRemoteNormal:FireServer() end)
	return true, "FORGED!"
	end

	return false, string.format("Need %s %s", costData.currency, costData.rune)
end


    elseif FontColors and FontColors[currencyName] then
        colorHex = FontColors[currencyName]      -- Warna dari tabel FontColors
    else
    	if currencyName == "Coconuts" then
    		colorHex = SummerFontColors["Beach"]
    	elseif SummerFontColors and SummerFontColors[currencyName] then
    		colorHex = SummerFontColors[currencyName]
    	else
    		colorHex = "#FFFFFF"                     -- Fallback putih
    	end
    end

    -- Lock / Unlock
    if not visible then
        toggle:Lock("🔒 Locked")
    else
        toggle:Unlock()
    end

    if currentLevel >= maxLevel then
        -- Saat max level, tampil sederhana tanpa warna
        titleText = string.format("%s (MAX)", upgradeData.Name)
        descText = string.format("Buff: %s", rewardText)

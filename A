-- AUTO STRENGTH LEVEL (NEXT/PREVIOUS BERDASARKAN SYARAT)
-- =====================================================
StrengthRemote = ReplicatedStorage.Remotes.Features.Strength

function autoStrengthLevel()
	local weightObj = Player.others:FindFirstChild("weightlevel")
	if not weightObj then return false, "weightlevel not found" end

	local weightLevel = weightObj.Value
	local strengthObj = GetStatValueObj("Strength")
	if not strengthObj then return false, "Strength not found" end

	local strength = strengthObj.Value

	-- Hitung syarat level saat ini
	local reqCurrent = (weightLevel == 0) and EternityNum.fromNumber(0)
			   or EternityNum.pow(EternityNum.fromNumber(1000), weightLevel)

	-- Cek apakah strength cukup untuk level saat ini
	if not EternityNum.meeq(strength, reqCurrent) then
	-- Tidak cukup, turunkan level jika memungkinkan
	if weightLevel > 0 then
		pcall(function() StrengthRemote:FireServer("Previous") end)
		return true, string.format("Previous → Level %d", weightLevel - 1)
	else
		return false, "Level 0, strength belum cukup (stay)"
	end
	else
	-- Strength cukup untuk level saat ini, cek apakah bisa naik
	local reqNext = EternityNum.pow(EternityNum.fromNumber(1000), weightLevel + 1)
	if EternityNum.meeq(strength, reqNext) then
		-- Cukup untuk level berikutnya → Next
		pcall(function() StrengthRemote:FireServer("Next") end)
		return true, string.format("Next → Level %d", weightLevel + 1)
	else
		-- Tidak cukup untuk next, stay di level sekarang
		return false, string.format("Stay di Level %d (belum cukup untuk next)", weightLevel)
	end
	end
end


-- FUNGSI: DAPATKAN INDEX GRADE (TAMBAHKAN INI)
-- =====================================================
function getGradeIndex(grade)
	for i, g in ipairs(RankGrades) do
	if g == grade then return i end
	end
	return 0
end

-- =====================================================
-- FUNGSI: Auto Lock Rank (LOCK JIKA GRADE >= TARGET) ← GANTI INI
-- =====================================================
function autoLockRankDynamic()
	if SelectedTargetGrade == "None" then return false, "No target grade" end
	
	local targetIndex = getGradeIndex(SelectedTargetGrade)
	if targetIndex == 0 then return false end
	
	-- Cek biaya lock
	local lockCount = 0
	for _, child in ipairs(Player.Ranks:GetChildren()) do
	if child.Name:match("Lock") and child.Value == true then
		lockCount = lockCount + 1
	end
	end
	local cost = 2 ^ lockCount
	
	-- Cek Husk cukup
	if not EternityNum.meeq(Player.others.Husk.Value, cost) then
	return false, "Not enough Husk"
	end
	
	-- Loop semua kategori rank
	for _, category in ipairs(RankCategories) do
	-- Cek apakah sudah dilock
	local lockObj = Player.Ranks:FindFirstChild(category .. "Lock")
	if lockObj and lockObj.Value then continue end  -- Sudah dilock, skip
	
	-- Cek current grade
	local currentGrade = Player.Ranks[category].Value
	local currentIndex = getGradeIndex(currentGrade)
	
	-- ✅ Jika current grade >= target grade → LOCK!
	if currentIndex >= targetIndex then
		pcall(function()
		RanksRemote:FireServer(category)
		end)
		return true, string.format("%s locked at %s! (Target: %s)", category, currentGrade, SelectedTargetGrade)
	end
	end
	
	return false, "No matching rank"
end


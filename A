FM_Add("AutoFarm", StrengthGroup)

AutoStrengthToggle = StrengthGroup:Toggle({
	Title = "Auto Strength Level",
	Image = GetIcon(138248751764296),
	Flag = "AutoFarm_StrengthLevel_Cfg",
	Callback = function(val)
	Config.Upgraders.AutoStrengthLevel = val
	if val then
		startStrengthThread()
	else
		StopManagedLoop("AutoStrength")
		StrengthThread = nil
	end
	end
})

-- Update Status Real-time
StartStatusLoop("Status_StrengthLevel", 0.5, function()
	if not AutoStrengthToggle then
	return
	end

	local weightObj = Player.others:FindFirstChild("weightlevel")
	local wl = weightObj and weightObj.Value or 0
	local strengthObj = GetStatValueObj("Strength")
	local str = strengthObj and strengthObj.Value or EternityNum.fromNumber(0)
	local reqCurrent = (wl == 0) and EternityNum.fromNumber(0)
	or EternityNum.pow(EternityNum.fromNumber(1000), wl)
	local reqNext = EternityNum.pow(EternityNum.fromNumber(1000), wl + 1)
	local canCurrent = EternityNum.meeq(str, reqCurrent)
	local canNext = EternityNum.meeq(str, reqNext)

	local actionText
	if not canCurrent then
	actionText = "🔴 Akan Previous"
	elseif canNext then
	actionText = "🟢 Akan Next"
	else
	actionText = "🟡 Stay (cukup di level ini)"
	end

	local desc = string.format(
	"Level: %d\nReq saat ini: %s\nReq next: %s\nStrength: %s\n%s",
	wl,
	safeManagerText(reqCurrent, "stats"),
	safeManagerText(reqNext, "stats"),
	safeManagerText(str, "stats"),
	actionText
	)

	SafeSetDesc(AutoStrengthToggle, desc)
end)

-- =====================================================
-- AUTO BENCH PRESS (AUTO CLICK WHILE IN BENCH)
-- =====================================================
BenchRemote_Rep = ReplicatedStorage.Remotes.Features.BenchRep


-- Fungsi utama auto bench press
function autoSpeedPress()

	-- Kirim repetisi bench press
	pcall(function()
	TreadMillRemote:FireServer(false) -- true = auto
	end)

	-- Ambil cooldown sebelum mengirim agar tepat
	local cooldown = Boosts.SpeedCooldown(Player)
	if cooldown <= 0 then cooldown = 1 end

	return true, cooldown
end


-- Thread auto bench (dengan handling cooldown)
SpeedThread = nil
function startSpeedThread()
	-- Hentikan thread lama jika ada
	if SpeedThread then
	task.cancel(SpeedThread)
	SpeedThread = nil
	end

	SpeedThread = task.spawn(function()
	while Config.Upgraders.AutoSpeed and IsWindowAlive() do

		local success, result = autoSpeedPress()
		task.wait(result)
	end
	end)
end

AutoSpeedToggle = MainTabs:Toggle({
	Title = "Auto Speed Press",
	Image = GetIcon(110643376073562),
	Flag = "AutoFarm_SpeedPress_Cfg",
	Callback = function(val)
	Config.Upgraders.AutoSpeed = val
	if val then
		startSpeedThread()
	else
		if SpeedThread then
		task.cancel(SpeedThread)
		SpeedThread = nil
		end
	end
	end
})
FM_Add("AutoFarm", AutoSpeedToggle)

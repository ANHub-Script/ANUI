	end

	return false
end

function CountEnabledUpgrades()
	local count = 0
	for _, entry in ipairs(AllUpgradesOrdered) do
	if Config.Upgraders[entry.name] then
		count = count + 1
	end
	end
	return count
end

function TryBuyUpgrade(upgradeName, upgradeData)
	if not Config.Upgraders[upgradeName] then
	return false
	end

	if not checkVisible(upgradeData) then
	return false
	end

	local upgObj = GetUpgradeValueObj(upgradeData.UpgName)
	if not upgObj then
	return false
	end

	local currentLevel = upgObj.Value
	local maxLevel = calcMaxLevel(upgradeData)
	if currentLevel >= maxLevel then
	return false
	end

	local cost = calcCost(upgradeData, currentLevel)
	local currencyObj = GetStatValueObj(upgradeData.Currency)
	if not currencyObj then
	return false
	end

	if not EternityNum.meeq(currencyObj.Value, cost) then
	return false
	end

	UpgradeRemote:FireServer(upgradeName, "Max")
	return true
end

function GetAffordableUpgradesByCurrency()
	local groupedCandidates = {}

	for _, entry in ipairs(AllUpgradesOrdered) do
	local upgradeName = entry.name
	local upgradeData = entry.data

	if Config.Upgraders[upgradeName] and checkVisible(upgradeData) then
		local upgObj = GetUpgradeValueObj(upgradeData.UpgName)
		local currencyObj = GetStatValueObj(upgradeData.Currency)

		if upgObj and currencyObj then
		local currentLevel = upgObj.Value
		local maxLevel = calcMaxLevel(upgradeData)

		if currentLevel < maxLevel then
			local cost = calcCost(upgradeData, currentLevel)
			if cost and EternityNum.meeq(currencyObj.Value, cost) then
			local currency = upgradeData.Currency
			if not groupedCandidates[currency] then
				groupedCandidates[currency] = {}
			end

			table.insert(groupedCandidates[currency], {
				name = upgradeName,
				data = upgradeData,
				currency = currency,
				cost = cost,
			})
			end
		end
		end
	end
	end

	for _, candidates in pairs(groupedCandidates) do
	table.sort(candidates, function(a, b)
		if EternityNum.eq(a.cost, b.cost) then
		return a.name < b.name
		end

		return EternityNum.le(a.cost, b.cost)
	end)
	end

	return groupedCandidates
end

function ProcessUpgradeBatch(batchSize)
	local groupedCandidates = GetAffordableUpgradesByCurrency()
	local startedThreads = 0

	for _, currency in ipairs(CurrencyOrder) do
	if startedThreads >= batchSize then
		break
	end

	local candidates = groupedCandidates[currency]
	local candidate = candidates and candidates[1]

	if candidate and not UpgradeCurrencyLocks[currency] then
		UpgradeCurrencyLocks[currency] = true
		startedThreads = startedThreads + 1

		task.spawn(function()
		pcall(TryBuyUpgrade, candidate.name, candidate.data)
		UpgradeCurrencyLocks[currency] = nil
		end)
	end
	end
end

function startUpgradeWorker()
	StartManagedLoop("UpgradeWorker", 0.1, function()
	return HasEnabledUpgrades()
	end, function()
	ProcessUpgradeBatch(2)
	end)
end

UpgradeTickPending = false
UpgradeTickQueued = false

function RequestUpgradeTick()
	if UpgradeTickPending then
	UpgradeTickQueued = true
	return
	end
	UpgradeTickPending = true

	task.delay(0.08, function()
	UpgradeTickPending = false
	local enabledCount = CountEnabledUpgrades()
	if enabledCount > 0 then
		local batchSize = 4
		if enabledCount >= 12 then
		batchSize = 10
		elseif enabledCount >= 6 then
		batchSize = 6
		end
		ProcessUpgradeBatch(batchSize)
	end
	if UpgradeTickQueued then
		UpgradeTickQueued = false
		task.defer(RequestUpgradeTick)
	end
	end)
end

function SyncUpgradeStatesFromToggles()
	table.clear(UpgradeCurrencyLocks)

	local hasEnabled = false
	for upgradeName, toggle in pairs(UpgradeToggles) do
	local isEnabled = toggle and toggle.Value == true
	Config.Upgraders[upgradeName] = isEnabled or nil

	if isEnabled then
		hasEnabled = true
	end
	end

	if hasEnabled then
	startUpgradeWorker()
	RequestUpgradeTick()
	end
end


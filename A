-- =====================================================
function updateTreeProgress()
	for treeType, config in pairs(TreeData) do
	local playerFolder = Player:FindFirstChild(config.PlayerFolderName)
	if not playerFolder then continue end

	local unlocked = 0
	local maxed = 0
	local total = #SortedTrees[treeType]

	for _, entry in ipairs(SortedTrees[treeType]) do
		if checkTreeUnlock(entry.data, entry.name, playerFolder) then
		unlocked = unlocked + 1
		local lv = getTreeLevelGeneric(entry.name, playerFolder)
		if lv >= entry.data.Max then maxed = maxed + 1 end
		end
	end

	local cacheKey = unlocked .. "_" .. maxed
	if LastTreeProgress[treeType] == cacheKey then continue end
	LastTreeProgress[treeType] = cacheKey

	local pct = total > 0 and math.floor(unlocked / total * 100) or 0
	local bar = string.rep("█", math.floor(pct / 10)) .. string.rep("░", 10 - math.floor(pct / 10))
	local text = string.format("Progress: [%s] %d%%\nUnlocked: %d/%d\nMaxed: %d", bar, pct, unlocked, total, maxed)

	if config.UseParagraph then
		local paragraph = TreeParagraphs[treeType]
		if paragraph and IsWindowReady() then
		SafeSetDesc(paragraph, text)
		end
	else
		local toggle = TreeToggles[treeType]
		if toggle and IsWindowReady() then
		SafeSetDesc(toggle, text)
		end
	end
	end
end


function checkTreeUnlock(upgradeData, upgradeName, playerFolder)
	if upgradeName and playerFolder then
	local treeValue = playerFolder:FindFirstChild(upgradeName)
	if treeValue and EternityNum.meeq(treeValue.Value, 1) then
		return true
	end
	end
	if not upgradeData.Unlocks then return true end
	for _, condition in ipairs(upgradeData.Unlocks) do
	local folder, stat, op, value = unpack(condition)
	local folderObj = Player:FindFirstChild(folder)
	local statObj = folderObj and folderObj:FindFirstChild(stat)
	if not (folderObj and statObj) then return false end
	local compareFunc = EternityNum[op]
	if not compareFunc or not compareFunc(statObj.Value, value) then
		return false
	end
	end
	return true
end

-- Fungsi generik untuk cek bisa beli
function canBuyTreeGeneric(upgradeData, level)
	if upgradeData.Max <= level then return false end
	local currencyObj = Player.stats:FindFirstChild(upgradeData.Cost.Currency)
	if not currencyObj then return false end
	local cost = tonumber(upgradeData.Cost.BaseCost) or 0
	if level > 0 then
	cost = cost * math.pow(tonumber(upgradeData.Cost.Scale) or 1, level)
	end
	return EternityNum.meeq(currencyObj.Value, cost)
end

-- Ambil level dari folder
function getTreeLevelGeneric(upgradeName, playerFolder)
	if not playerFolder then return 0 end
	local obj = playerFolder:FindFirstChild(upgradeName)
	return obj and obj.Value or 0
end

-- Sorted list (dibuat sekali saja)
SortedTrees = {}
for treeType, config in pairs(TreeData) do
	local sorted = {}
	for name, data in pairs(config.Module) do
	table.insert(sorted, { name = name, data = data })
	end
	table.sort(sorted, function(a, b)
	local numA = tonumber(string.match(a.name, "%d+")) or 0
	local numB = tonumber(string.match(b.name, "%d+")) or 0
	return numA < numB
	end)
	SortedTrees[treeType] = sorted
end

